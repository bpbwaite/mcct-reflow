{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "uv run ../mcct.py build",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": {
                "owner": "sdcc",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+): (warning|error|syntax error)[^:]*: (.*)$",
                    "file": 1, "line": 2, "severity": 3, "message": 4
                }
            }
        },
        {
            "label": "Unit Tests (8051 simulator)",
            "type": "shell",
            "command": "uv run ../mcct.py test",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Bench Build + Flash (simulated plate)",
            "type": "shell",
            "command": "uv run ../mcct.py flash --sim ${input:port}",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "uv run ../mcct.py build --clean",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build + Flash (Arduino ICP)",
            "type": "shell",
            "command": "uv run ../mcct.py flash ${input:port}",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build + Flash + Monitor",
            "type": "shell",
            "command": "uv run ../mcct.py flash --monitor ${input:port}",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Serial Monitor (bridge passthrough)",
            "type": "shell",
            "command": "uv run ../mcct.py monitor ${input:port}",
            "problemMatcher": []
        },
        {
            "label": "Chip Status (Arduino ICP)",
            "type": "shell",
            "command": "uv run ../mcct.py status ${input:port}",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "port",
            "type": "promptString",
            "description": "Port option, e.g. --port COM5 (empty: find the Uno)",
            "default": ""
        }
    ]
}

   digitalWrite(BUILTIN_LED, LOW);
+#endif
+}
+
+// ---------------------------------------------------------------------------
+// LOCAL PATCH: UART passthrough
+//
+// The MS51's UART1 shares its pins with ICP (P1.6 = ICPDA = UART1_TXD,
+// P0.2 = ICPCK = UART1_RXD). While no ISP session is active the bridge
+// releases nRESET (the target runs) and forwards bytes between USB and the
+// target's UART1 using SoftwareSerial on the ICP pins. When the host sends the
+// start of a CMD_CONNECT packet (AE 00 00 00) the bridge leaves passthrough and
+// handles ISP/ICP exactly as before. CMD_RUN_APROM/RESET (sent by nuvoispy on
+// exit), a half-received connect packet, or CONNECTION_TIMEOUT return it to
+// passthrough.
+// ---------------------------------------------------------------------------
+#ifndef PASSTHROUGH_BAUD
+#define PASSTHROUGH_BAUD 38400   // target UART1 baud; SoftwareSerial RX is reliable to ~57600
+#endif
+#ifndef ARDUINO_AVR_MEGA2560
+#define PT_RX_PIN  11   // ICPDA  <- target UART1_TXD (P1.6)
+#define PT_TX_PIN  12   // ICPCK  -> target UART1_RXD (P0.2)
+#define PT_RST_PIN 13   // nRESET
+#else
+#define PT_RX_PIN  52
+#define PT_TX_PIN  50
+#define PT_RST_PIN 48
+#endif
+#define PT_SIG_LEN       4    // AE 00 00 00 starts every CMD_CONNECT packet
+#define PT_SIG_FLUSH_MS  20   // a partial match older than this was user data
+
+SoftwareSerial target_uart(PT_RX_PIN, PT_TX_PIN);
+static const uint8_t pt_sig[PT_SIG_LEN] = {CMD_CONNECT, 0, 0, 0};
+static uint8_t pt_sig_len = 0;
+static unsigned long pt_sig_time = 0;
+static bool pt_active = false;
+
+void start_passthrough() {
+  if (pt_active) return;
+  pinMode(PT_RST_PIN, INPUT);        // release nRESET -> target runs
+  target_uart.begin(PASSTHROUGH_BAUD);
+  target_uart.listen();
+  pt_sig_len = 0;
+  pt_active = true;
+}
+
+void stop_passthrough() {
+  if (!pt_active) return;
+  target_uart.end();
+  pinMode(PT_TX_PIN, INPUT);
+  pinMode(PT_RX_PIN, INPUT);
+  pt_active = false;
+}
+
+// Forward bytes that looked like the start of a connect packet but weren't.
+static void pt_flush_sig() {
+  for (uint8_t i = 0; i < pt_sig_len; i++)
+    target_uart.write(pt_sig[i]);
+  pt_sig_len = 0;
+}
+
+// Returns true when a CMD_CONNECT signature was seen and ISP should take over.
+bool passthrough_poll() {
+  while (target_uart.available())
+    Serial.write((uint8_t)target_uart.read());
+
+  while (Serial.available()) {
+    uint8_t b = Serial.read();
+    if (b == pt_sig[pt_sig_len]) {
+      pt_sig_len++;
+      pt_sig_time = millis();
+      if (pt_sig_len == PT_SIG_LEN) {
+        stop_passthrough();
+        memcpy(rx_buf, pt_sig, PT_SIG_LEN);
+        rx_bufhead = PT_SIG_LEN;
+        state = CONNECTING_STATE;     // the next byte moves it to WAITING_FOR_CONNECT_CMD
+        last_byte_time = millis();
+        pt_sig_len = 0;
+        return true;
+      }
+    } else {
+      pt_flush_sig();
+      if (b == pt_sig[0]) {
+        pt_sig_len = 1;
+        pt_sig_time = millis();
+      } else {
+        target_uart.write(b);
+      }
+    }
+  }
+  if (pt_sig_len && millis() - pt_sig_time > PT_SIG_FLUSH_MS)
+    pt_flush_sig();
+  return false;
 }
 
